# AegisBid Midnight wiring. Copy nothing secret into the repo.
# Browser (Vite) values — public endpoints and the deployed address only:
VITE_MIDNIGHT_NETWORK_ID=undeployed
VITE_AEGISBID_CONTRACT=21b2efc6d75311c13c42f131ea48406539a5a461ecb32f7fb7e0e460e9bdc957
VITE_MIDNIGHT_PROOF_SERVER=http://localhost:6300
VITE_AEGISBID_V2_ZK_CONFIG_BASE=https://cdn.jsdelivr.net/gh/dinitheth/AegisBid@8c335f5f3edca4a431053bfd8ed137afbb2430b5/managed/aegis-bid-v2

# Deploy script only (shell env, NEVER commit):
# MIDNIGHT_SEED=<64-hex wallet seed>      # required for preview/preprod
# MIDNIGHT_COMPACT_BIN=<path/to/compact>  # real Midnight compiler binary

# Shared tender registry (server only — no VITE_ prefix, never reaches the
# browser). Upstash Redis REST credentials; when unset, publishing stays
# device-local and the directory shows flagship + local publishes only.
# TENDER_REGISTRY_URL=https://xxx.upstash.io
# TENDER_REGISTRY_TOKEN=

# Midnight indexer (server only — no VITE_ prefix, never reaches the
# browser). Midnight decommissioned its hosted preprod/mainnet indexers
# (HTTP 410 since 2026-10-09); the same-origin /api/midnight/indexer proxy
# now forwards those networks to Blockfrost. Create one project per network
# at https://blockfrost.io (Midnight Preprod / Midnight Mainnet) and paste
# the project tokens here and in Vercel env vars. Preview needs no token.
# BLOCKFROST_PREPROD_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXX
# BLOCKFROST_MAINNET_PROJECT_ID=mainnetXXXXXXXXXXXXXXXXXXXXXXXX
