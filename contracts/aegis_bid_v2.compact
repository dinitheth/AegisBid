// AegisBid V2 — shielded tender rules for Midnight Preprod (ledger 8).
//
// V2 intentionally has a new address. V1 remains immutable and is retained
// for historical preprod records. Compile with Compact toolchain 0.31.1.
pragma language_version 0.23;

import CompactStandardLibrary;

export enum TenderMode { HighestBid, LowestCompliant }
export enum TenderPhase { Open, Evaluating, Settled, Cancelled }

export struct TenderConfig {
  issuer: Bytes<32>;
  deadline: Uint<64>;
  reserve: Uint<128>;
  mode: TenderMode;
  specificationRoot: Bytes<32>;
}

export struct SettlementReceipt {
  winnerCommitment: Bytes<32>;
  winningValue: Uint<128>;
  comparisonRoot: Bytes<32>;
}

// Public state deliberately contains policy, commitments and receipt only.
export ledger tender: TenderConfig;
export ledger phase: TenderPhase;
export ledger commitmentCount: Counter;
export ledger commitments: Map<Bytes<32>, Boolean>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger evaluatorCommitment: Bytes<32>;
export ledger settlement: Maybe<SettlementReceipt>;

// Bid witnesses remain private on the bidder device.
witness localBidAmount(): Uint<128>;
witness localBidSalt(): Bytes<32>;

// This deployment-specific capability is generated by the issuer and must be
// retained outside the public ledger. Preprod ledger 8 has no authenticated
// `kernel.caller()` operation, so a public issuer key alone cannot authorize
// an evaluator circuit.
witness evaluatorSecret(): Bytes<32>;

// Evaluator-provided settlement witnesses. V2 verifies the proof but does not
// claim that it solves multi-device witness delivery; the DApp must supply an
// encrypted escrow/recovery transport before presenting live settlement.
witness settlementBid(index: Uint<16>): Uint<128>;
witness settlementSalt(index: Uint<16>): Bytes<32>;
witness settlementKey(index: Uint<16>): Bytes<32>;

constructor(config: TenderConfig) {
  tender = disclose(config);
  evaluatorCommitment = disclose(persistentHash<Bytes<32>>(evaluatorSecret()));
  phase = TenderPhase.Open;
  settlement = none<SettlementReceipt>();
}

circuit requireEvaluator(): [] {
  const suppliedCommitment = disclose(persistentHash<Bytes<32>>(evaluatorSecret()));
  assert(suppliedCommitment == evaluatorCommitment, "UNAUTHORIZED_EVALUATOR");
}

export circuit submitBid(bidderPublicKey: Bytes<32>): Bytes<32> {
  assert(phase == TenderPhase.Open, "TENDER_NOT_OPEN");
  // Midnight's ledger evaluates this against the transaction block time, not
  // a timestamp supplied by the DApp.
  assert(blockTimeLt(tender.deadline), "DEADLINE_ELAPSED");

  const amount = localBidAmount();
  const salt = localBidSalt();

  // A stable wallet-derived public key gives one nullifier per deployed
  // tender. It removes the old per-bid random identity witness. This is not
  // a credential/Sybil system: a person can still use a different wallet.
  const identityNullifier = disclose(
    persistentHash<[Bytes<32>, Bytes<32>]>([kernel.self().bytes, bidderPublicKey])
  );
  assert(!nullifiers.member(identityNullifier), "IDENTITY_ALREADY_USED");

  const commitment = persistentCommit<[Uint<128>, Bytes<32>]>([amount, bidderPublicKey], salt);
  assert(!commitments.member(commitment), "DUPLICATE_COMMITMENT");

  commitments.insert(commitment, true);
  nullifiers.insert(identityNullifier);
  commitmentCount.increment(1);
  return commitment;
}

export circuit beginEvaluation(): [] {
  assert(phase == TenderPhase.Open, "TENDER_NOT_OPEN");
  assert(blockTimeGte(tender.deadline), "DEADLINE_NOT_REACHED");
  requireEvaluator();
  phase = TenderPhase.Evaluating;
}

export circuit settle(winningIndex: Uint<16>, bidCount: Uint<16>): SettlementReceipt {
  assert(phase == TenderPhase.Evaluating, "NOT_EVALUATING");
  requireEvaluator();
  assert(bidCount == commitmentCount.read(), "INCOMPLETE_BID_SET");
  // Eight comparisons keep V2's proving key small enough to distribute with
  // the browser DApp. Larger tenders should be split into lots or settled by
  // a purpose-built batched/recursive proof system.
  assert(bidCount <= 8, "TOO_MANY_BIDS");

  const winningAmount = settlementBid(winningIndex);
  const winningSalt = settlementSalt(winningIndex);
  const winningKey = settlementKey(winningIndex);
  const winnerCommitment = persistentCommit<[Uint<128>, Bytes<32>]>([winningAmount, winningKey], winningSalt);
  assert(commitments.lookup(winnerCommitment), "UNKNOWN_WINNER");

  for (const i of 0 .. 8) {
    if (disclose(i < bidCount)) {
      const candidateAmount = settlementBid(i);
      const candidateSalt = settlementSalt(i);
      const candidateKey = settlementKey(i);
      const candidateCommitment = persistentCommit<[Uint<128>, Bytes<32>]>([candidateAmount, candidateKey], candidateSalt);
      assert(commitments.lookup(candidateCommitment), "UNCOMMITTED_BID");

      if (tender.mode == TenderMode.HighestBid) {
        assert(winningAmount >= candidateAmount, "NOT_MAXIMUM");
      } else {
        assert(winningAmount <= candidateAmount, "NOT_MINIMUM");
      }
    }
  }

  if (tender.mode == TenderMode.HighestBid) {
    assert(winningAmount >= tender.reserve, "RESERVE_NOT_MET");
  } else {
    assert(winningAmount <= tender.reserve, "CEILING_EXCEEDED");
  }

  const receipt = SettlementReceipt {
    winnerCommitment,
    winningValue: disclose(winningAmount),
    comparisonRoot: disclose(
      persistentHash<[Bytes<32>, Uint<16>, Bytes<32>]>(
        [winnerCommitment, bidCount, tender.specificationRoot]
      )
    )
  };
  settlement = some<SettlementReceipt>(receipt);
  phase = TenderPhase.Settled;
  return receipt;
}
