// AegisBid shielded-tender circuits for Midnight Network.
//
// Toolchain baseline: Compact language 0.16 (`pragma language_version >= 0.16`).
// See contracts/COMPACT_TOOLCHAIN.md for the pinned references and how to run
// `npm run compact:check` (structural gate + optional full compile).
// The TypeScript executable spec of these circuits lives in
// src/features/aegis/tenderEngine.ts and is asserted by `npm test`.
//
// Privacy boundary: raw bid amounts, salts, and identity secrets enter only
// via witnesses. Public ledger state carries commitments, nullifiers, phase,
// and the settlement receipt. Bid commitments use persistentCommit (salt blinds
// the value, no disclose needed); nullifiers are disclosed persistentHash
// values (deterministic by design); the winning value leaves via disclose().
pragma language_version >= 0.16;

import CompactStandardLibrary;

export enum TenderMode { HighestBid, LowestCompliant }
export enum TenderPhase { Open, Evaluating, Settled, Cancelled }

export struct TenderConfig {
  issuer: Bytes<32>;
  deadline: Uint<64>;
  reserve: Uint<128>;
  mode: TenderMode;
  specificationRoot: Bytes<32>;
}

export struct SettlementReceipt {
  winnerCommitment: Bytes<32>;
  winningValue: Uint<128>;
  comparisonRoot: Bytes<32>;
  settledAt: Uint<64>;
}

// Public Midnight ledger: raw bids and bidder identities never enter this state.
export ledger tender: TenderConfig;
export ledger phase: TenderPhase;
export ledger commitmentCount: Counter;
export ledger commitments: Map<Bytes<32>, Boolean>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger settlement: Maybe<SettlementReceipt>;

// Private inputs are resolved by the DApp's TypeScript witness provider.
witness localBidAmount(): Uint<128>;
witness localBidSalt(): Bytes<32>;
witness localIdentitySecret(): Bytes<32>;
witness settlementBid(index: Uint<16>): Uint<128>;
witness settlementSalt(index: Uint<16>): Bytes<32>;
witness settlementKey(index: Uint<16>): Bytes<32>;

constructor(config: TenderConfig) {
  tender = config;
  phase = TenderPhase.Open;
  // commitmentCount is a Counter and defaults to 0 (`=` is undefined for it).
  settlement = none<SettlementReceipt>();
}

export circuit submitBid(
  bidderPublicKey: Bytes<32>,
  now: Uint<64>
): Bytes<32> {
  assert(phase == TenderPhase.Open, "TENDER_NOT_OPEN");
  assert(now < tender.deadline, "DEADLINE_ELAPSED");

  const amount = localBidAmount();
  const salt = localBidSalt();
  const identity = localIdentitySecret();
  // Deterministic nullifier: a disclosed hash (no randomness by design).
  const identityNullifier = disclose(persistentHash<[Bytes<32>, Bytes<32>]>([identity, tender.issuer]));
  assert(!nullifiers.member(identityNullifier), "IDENTITY_ALREADY_USED");

  // Hiding commitment: persistentCommit blinds (amount, key) with the random salt.
  const commitment = persistentCommit<[Uint<128>, Bytes<32>]>([amount, bidderPublicKey], salt);
  assert(!commitments.member(commitment), "DUPLICATE_COMMITMENT");

  commitments.insert(commitment, true);
  nullifiers.insert(identityNullifier);
  commitmentCount.increment(1);
  return commitment;
}

export circuit beginEvaluation(now: Uint<64>): [] {
  assert(phase == TenderPhase.Open, "TENDER_NOT_OPEN");
  assert(now >= tender.deadline, "DEADLINE_NOT_REACHED");
  phase = TenderPhase.Evaluating;
}

export circuit settle(
  winningIndex: Uint<16>,
  bidCount: Uint<16>,
  now: Uint<64>
): SettlementReceipt {
  assert(phase == TenderPhase.Evaluating, "NOT_EVALUATING");
  assert(bidCount == commitmentCount.read(), "INCOMPLETE_BID_SET");

  const winningAmount = settlementBid(winningIndex);
  const winningSalt = settlementSalt(winningIndex);
  const winningKey = settlementKey(winningIndex);
  const winnerCommitment = persistentCommit<[Uint<128>, Bytes<32>]>([winningAmount, winningKey], winningSalt);
  assert(commitments.lookup(winnerCommitment), "UNKNOWN_WINNER");

  // Bounded loop: Compact only allows constant `0 .. N` ranges, so iterate
  // to MAX_SETTLEMENT_BIDS (64) and check indices below the runtime bidCount.
  // Larger bid sets fail closed via TOO_MANY_BIDS instead of going unchecked.
  assert(bidCount <= 64, "TOO_MANY_BIDS");
  for (const i of 0 .. 64) {
    if (i < bidCount) {
      const candidateAmount = settlementBid(i);
      const candidateSalt = settlementSalt(i);
      const candidateKey = settlementKey(i);
      const candidateCommitment = persistentCommit<[Uint<128>, Bytes<32>]>([candidateAmount, candidateKey], candidateSalt);
      assert(commitments.lookup(candidateCommitment), "UNCOMMITTED_BID");

      if (tender.mode == TenderMode.HighestBid) {
        assert(winningAmount >= candidateAmount, "NOT_MAXIMUM");
      } else {
        assert(winningAmount <= candidateAmount, "NOT_MINIMUM");
      }
    }
  }

  assert(
    tender.mode == TenderMode.LowestCompliant || winningAmount >= tender.reserve,
    "RESERVE_NOT_MET"
  );

  const receipt = SettlementReceipt {
    winnerCommitment,
    winningValue: disclose(winningAmount),
    comparisonRoot: persistentHash<[Bytes<32>, Uint<16>, Bytes<32>]>([winnerCommitment, bidCount, tender.specificationRoot]),
    settledAt: now
  };
  settlement = some<SettlementReceipt>(receipt);
  phase = TenderPhase.Settled;
  return receipt;
}
